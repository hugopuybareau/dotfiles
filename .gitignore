# real litellm config holds master_key (use config.yaml.example)
litellm/config.yaml
# GCP service-account keys
**/*-sa.json
**/vertex-sa.json
# Claude Code login tokens
claude/.claude/.credentials.json
claude/.claude/.credentials.lock

# --- Claude Code runtime state, caches & backups ---
claude/.claude/plugins/plugin-directory-cache*.json
claude/.claude/plugins/store/
claude/.claude/plugins/synced/
claude/.claude/state/
